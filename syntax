# Configure the AWS Provider for the Hyderabad region
provider "aws" {
  region = "ap-south-2"
}

# 1. Create the VPC
resource "aws_vpc" "main_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "hyderabad-vpc"
  }
}

# 2. Create an Internet Gateway (needed for the public subnet)
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main_vpc.id

  tags = {
    Name = "hyderabad-igw"
  }
}

# 3. Create the Public Subnet (AZ: ap-south-2a)
resource "aws_subnet" "public_subnet" {
  vpc_id                  = aws_vpc.main_vpc.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "ap-south-2a"
  map_public_ip_on_launch = true # Auto-assigns public IPs to instances

  tags = {
    Name = "public-subnet-2a"
  }
}

# 4. Create the Private Subnet (AZ: ap-south-2b)
resource "aws_subnet" "private_subnet" {
  vpc_id            = aws_vpc.main_vpc.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "ap-south-2b"

  # Instances here will not get public IPs by default

  tags = {
    Name = "private-subnet-2b"
  }
}

# 5. Create a Route Table for the public subnet
resource "aws_route_table" "public_rt" {
  vpc_id = aws_vpc.main_vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }

  tags = {
    Name = "public-route-table"
  }
}

# 6. Associate the Route Table with the Public Subnet
resource "aws_route_table_association" "public_rt_assoc" {
  subnet_id      = aws_subnet.public_subnet.id
  route_table_id = aws_route_table.public_rt.id
}
# 7. Fetch the latest Ubuntu 22.04 AMI via SSM Parameter Store
data "aws_ssm_parameter" "ubuntu_2204" {
  name = "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
}

# 8. Create a Security Group for the EC2 Instance
resource "aws_security_group" "public_ec2_sg" {
  name        = "public-ec2-sg"
  description = "Allow SSH inbound and all outbound internet traffic"
  vpc_id      = aws_vpc.main_vpc.id

  # Inbound rules
  ingress {
    description = "Allow SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"] # Note: For better security, replace with your specific IP address e.g., ["203.0.113.0/32"]
  }

  # Outbound rules
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "public-ec2-sg"
  }
}

# 9. Create the EC2 Instance in the Public Subnet
resource "aws_instance" "public_ubuntu" {
  ami           = data.aws_ssm_parameter.ubuntu_2204.value
  instance_type = "t3.micro" # Note: t3 instances are generally preferred/available in newer regions like ap-south-2
  subnet_id     = aws_subnet.public_subnet.id

  vpc_security_group_ids = [aws_security_group.public_ec2_sg.id]

  # Optional: Automatically assign a public IP (redundant if map_public_ip_on_launch is true on the subnet, but good practice to explicitly state)
  associate_public_ip_address = true
  # key_name = aws_key_pair.deployer_key.key_name
  key_name = "kp"   
  tags = {
    Name = "public-ubuntu-server"
  }
}

# 10. Output the Public IP to easily access it after creation
output "ec2_public_ip" {
  description = "The public IP address of the Ubuntu instance"
  value       = aws_instance.public_ubuntu.public_ip
}
